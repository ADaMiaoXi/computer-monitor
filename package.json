{
  "name": "computer_monitor",
  "version": "1.0.0",
  "main": "src/js/main.js",
  "scripts": {
    "open_window": "nodemon --exec electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.shijianshu.monitor",
    "win": {
      "icon": "./static/icons/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    }
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "electron": "^33.0.1",
    "electron-builder": "^25.1.8",
    "nodemon": "^3.1.7"
  }
}
